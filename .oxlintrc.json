{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["eslint", "typescript", "import", "unicorn", "promise", "node", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "rules": {
    "func-style": ["error", "expression", { "allowArrowFunctions": true }],
    "prefer-arrow-callback": ["error", { "allowNamedFunctions": false, "allowUnboundThis": false }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": ["error", { "destructuring": "all" }],
    "object-shorthand": ["error", "always"],
    "prefer-template": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "no-else-return": "error",
    "no-nested-ternary": "error",
    "no-negated-condition": "error",
    "no-param-reassign": "error",
    "no-shadow": "error",
    "no-empty": "error",
    "no-empty-function": "error",
    "no-debugger": "error",
    "no-alert": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-return-assign": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "no-array-constructor": "error",
    "no-useless-constructor": "error",
    "no-useless-rename": "error",
    "no-lonely-if": "error",
    "no-multi-str": "error",
    "no-throw-literal": "error",
    "no-labels": "error",
    "no-void": "error",
    "symbol-description": "error",
    "default-param-last": "error",
    "array-callback-return": "error",
    "require-await": "off",
    "no-console": "off",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "no-undef": "off",
    "no-redeclare": "off",
    "no-use-before-define": "off",
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "fix": { "imports": "safe-fix" }
      }
    ],

    "complexity": ["error", { "max": 15 }],
    "max-depth": ["error", 4],
    "max-params": ["error", 4],
    "max-nested-callbacks": ["error", 3],
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 120, "skipBlankLines": true, "skipComments": true }
    ],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-require-imports": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/array-type": ["error", { "default": "array-simple" }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      { "disallowTypeAnnotations": false, "fixStyle": "separate-type-imports" }
    ],
    "typescript/dot-notation": "error",
    "typescript/no-unused-vars": ["error", { "fix": { "imports": "safe-fix" } }],
    "typescript/explicit-function-return-type": [
      "error",
      {
        "allowExpressions": true,
        "allowTypedFunctionExpressions": true,
        "allowHigherOrderFunctions": true
      }
    ],

    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/promise-function-async": "error",
    "typescript/require-await": "error",
    "typescript/return-await": ["error", "always"],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unnecessary-condition": "off",

    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-mutable-exports": "error",
    "import/no-absolute-path": "error",
    "import/no-commonjs": "error",
    "import/first": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",

    "node/no-exports-assign": "error",
    "node/no-new-require": "error",

    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/error-message": "error",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-useless-length-check": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/no-await-expression-member": "error",
    "unicorn/no-zero-fractions": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-null": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],

    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/no-new-statics": "error",
    "promise/valid-params": "error",
    "promise/prefer-await-to-then": "error",
    "promise/always-return": "off",

    "oxc/no-async-await": "off",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-rest-spread-properties": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "dist/**",
    "**/*.d.ts",
    "docs/**",
    "skill/**",
    "test/fixture.css",
    "probe.mjs"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "test/**/*.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/require-await": "off",
        "typescript/unbound-method": "off",
        "typescript/explicit-function-return-type": "off"
      }
    },
    {
      "files": ["src/cli.ts"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 200, "skipBlankLines": true, "skipComments": true }
        ]
      }
    }
  ]
}
