{
  "name": "tw2stylex",
  "version": "0.3.0",
  "description": "Agent-driven Tailwind to StyleX migration codemod. Converts what it can prove, reports what it can't.",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "stylex",
    "codemod",
    "migration",
    "cli",
    "ai-agent",
    "coding-agent",
    "claude-code"
  ],
  "homepage": "https://github.com/AlshehriAli0/tw2stylex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlshehriAli0/tw2stylex.git",
    "directory": "packages/tw2stylex"
  },
  "bugs": {
    "url": "https://github.com/AlshehriAli0/tw2stylex/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "tw2sx": "./dist/cli.js",
    "tw2stylex": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "bun run src/cli.ts",
    "types:check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/core": "^7",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "magic-string": "^1.2.2",
    "postcss": "^8"
  },
  "peerDependencies": {
    "tailwindcss": "^3 || ^4"
  },
  "publishConfig": {
    "access": "public"
  }
}
