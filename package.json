{
  "name": "tw2sx",
  "version": "0.1.0",
  "description": "Agent-driven Tailwind to StyleX migration codemod. Converts what it can prove, reports what it can't.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tw2sx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "keywords": [
    "tailwind",
    "tailwindcss",
    "stylex",
    "codemod",
    "migration",
    "cli",
    "ai-agent",
    "coding-agent",
    "claude-code"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "types:check": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run types:check && bun test",
    "prepublishOnly": "bun run check",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/core": "^7",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "magic-string": "^1.2.2",
    "postcss": "^8"
  },
  "peerDependencies": {
    "tailwindcss": "^3 || ^4"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "tailwindcss3": "npm:tailwindcss@^3",
    "typescript": "^7.0.2"
  }
}
