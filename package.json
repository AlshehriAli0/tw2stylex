{
  "name": "tw2stylex-repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for tw2stylex, the agent-driven Tailwind to StyleX migration codemod.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlshehriAli0/tw2stylex.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/tw2stylex build",
    "dev": "bun run --cwd packages/tw2stylex dev",
    "test": "bun test packages/",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "types:check": "tsc -p tsconfig.check.json",
    "check": "bun run format:check && bun run lint && bun run types:check && bun run test",
    "pack": "bun run scripts/pack.ts",
    "demo": "bun run scripts/demo-svg.ts"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "tailwindcss3": "npm:tailwindcss@^3",
    "typescript": "^7.0.2"
  }
}
