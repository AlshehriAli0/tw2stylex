{
  "name": "tw2sx",
  "version": "0.1.0",
  "description": "Tailwind v4 to StyleX migration codemod. Converts what it can prove, reports what it can't.",
  "type": "module",
  "bin": {
    "tw2sx": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "types:check": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run types:check && bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "magic-string": "^1.2.2",
    "postcss": "^8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  }
}
